context postmanEcho {
    defaults http {
        baseUrl: "https://postman-echo.com"
        timeout: 10s
        maxResponseBytes: 1_048_576

        headers: {
            "Accept": "application/json"
        }
    }
}

flow createUserFromSeed() {
    use context postmanEcho

    seed = http.get("/get?sourceId=seed-42&name=Ada")

    created = http.post("/post") {
        json: {
            sourceId: seed.json.args.sourceId
            name: seed.json.args.name
            active: true
            roles: ["tester"]
        }
    }

    return created.json.json
}

flow main() {
    return createUserFromSeed()
}
