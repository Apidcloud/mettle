// Policies accept one expression. Put multi-step work in a helper flow.
flow fetchStatus(path) {
    response = http.get("https://jsonplaceholder.typicode.com${path}")
    assert(response.status == 200)
    return response.status
}

flow probe(path) = retry(attempts: 3, delay: 100ms) { fetchStatus(path) }

flow main() {
    responses = within(timeout: 5s) {
        parallel(limit: 2) {
            probe("/posts/1")
            probe("/users/1")
            probe("/todos/1")
        }
    }

    return responses
}
