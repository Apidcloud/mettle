// Run: API_TOKEN=demo-token mettle run examples/language/secrets.mettle
// Supply API_TOKEN in the process environment before running this file.
// This example never sends the token over the network.
use context {
    token: senv("API_TOKEN")
}

flow main = "Bearer ${token}"

test "senv is secret(env(...))" {
    assert(token == secret(env("API_TOKEN")))
}
