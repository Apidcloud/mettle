// Run: mettle run examples/language/echo.mettle
// Messages belong to the flow report; parallel branches get logical labels.
flow greet(name) {
    echo("Greeting ${name}")
    "Hello, ${name}!"
}

flow main {
    echo("Starting two greetings")
    greetings = parallel {
        ada: greet("Ada")
        lin: greet("Lin")
    }
    echo({ count: 2, first: greetings.ada })
    greetings
}

test "greeting is returned" {
    echo("Checking the greeting flow")
    assert(greet("Ada") == "Hello, Ada!")
}
