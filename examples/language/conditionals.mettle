// Run: mettle run examples/language/conditionals.mettle
// Conditions, short-circuit booleans, and array/object access need no I/O.
flow chooseUser(users, position) {
    if (users == []) {
        fail("No users available")
    }
    user = users[position]
    if (user.active and not user.disabled) {
        return user.name
    } else if (user.active == false) {
        return "inactive"
    } else {
        return "disabled"
    }
}

flow main {
    users = [
        { name: "Ada", active: true, disabled: false },
        { name: "Lin", active: false, disabled: false }
    ]
    chooseUser(users, 0)
}

test "selects an active user" {
    users = [{ name: "Ada", active: true, disabled: false }]
    assert(chooseUser(users, 0) == "Ada")
    assert(users[0]["name"] == "Ada")
}
