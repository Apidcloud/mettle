// Run: mettle run examples/language/project/main.mettle --profile qa
// The project manifest discovers `core.mettle` and `users.mettle` automatically.
use namespace users

flow main {
    response = inspectRequest(1)
    assert(response.status == 200)
    assert(response.json.id == 1)
    {
        profile: env("PROFILE_NAME")
        post: response.json
    }
}
