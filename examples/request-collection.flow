// The smallest form: a top-level call is an independently runnable anonymous flow.
// Postman Echo is a public HTTPS test endpoint; this needs only an internet connection.
http.get("https://postman-echo.com/get?demo=bare")

// Add a name and parameters only when the flow needs them.
flow inspectRequest(baseUrl, requestId) =
    http.get("${baseUrl}/get?requestId=${requestId}")

// Anonymous flows can still contain a complete multi-operation workflow.
flow {
    seed = http.get("https://postman-echo.com/get?name=Ada")

    return http.post("https://postman-echo.com/post") {
        json: {
            sourceUrl: seed.json.url
            name: seed.json.args.name
            active: true
        }
    }
}
