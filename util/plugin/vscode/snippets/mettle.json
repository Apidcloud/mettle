{
  "Mettle declaration": {
    "prefix": "flow",
    "description": "Declare a reusable Mettle function",
    "body": [
      "flow ${1:name}(${2}) {",
      "    ${3:return null}",
      "}"
    ]
  },
  "Expression-bodied flow": {
    "prefix": "flowexpr",
    "description": "Declare a concise reusable Mettle function",
    "body": [
      "flow ${1:name}(${2}) = ${3:http.get(\"/path\")}"
    ]
  },
  "Anonymous workflow": {
    "prefix": "flowblock",
    "description": "Declare an anonymous multi-operation flow",
    "body": [
      "flow {",
      "    ${1:return http.get(\"/path\")}",
      "}"
    ]
  },
  "Runnable main flow": {
    "prefix": "flowmain",
    "description": "Declare the program entry flow",
    "body": [
      "flow main() {",
      "    ${1:return null}",
      "}"
    ]
  },
  "Namespace declaration": {
    "prefix": "namespace",
    "description": "Declare this file's namespace and an optional dependency",
    "body": [
      "namespace ${1:name}",
      "use namespace ${2:core}"
    ]
  },
  "Assertion": {
    "prefix": "assert",
    "description": "Assert that an expression is true",
    "body": [
      "assert(${1:response.status == 200})"
    ]
  },
  "Deadline scope": {
    "prefix": "within",
    "description": "Run one expression within a deadline",
    "body": [
      "within(timeout: ${1:2s}) {",
      "    ${2:http.get(\"/path\")}",
      "}"
    ]
  },
  "Retry scope": {
    "prefix": "retry",
    "description": "Retry one failing expression",
    "body": [
      "retry(attempts: ${1:3}, delay: ${2:50ms}) {",
      "    ${3:http.get(\"/path\")}",
      "}"
    ]
  },
  "Bounded parallel scope": {
    "prefix": "parallel",
    "description": "Run expressions concurrently with bounded fan-out",
    "body": [
      "parallel(limit: ${1:4}) {",
      "    ${2:http.get(\"/first\")}",
      "    ${3:http.get(\"/second\")}",
      "}"
    ]
  },
  "Rate workload": {
    "prefix": "rate",
    "description": "Start iterations at a fixed rate with bounded admission",
    "body": [
      "rate(target: ${1:100}, period: ${2:1s}, duration: ${3:30s}, limit: ${4:200}) {",
      "    ${5:http.get(\"/health\")}",
      "}"
    ]
  },
  "Fixed concurrency workload": {
    "prefix": "concurrency",
    "description": "Keep a fixed number of iterations active",
    "body": [
      "concurrency(limit: ${1:20}, duration: ${2:30s}) {",
      "    ${3:http.get(\"/health\")}",
      "}"
    ]
  },
  "HTTP context": {
    "prefix": "flowcontext",
    "description": "Declare an HTTP context",
    "body": [
      "context ${1:api} {",
      "    defaults http {",
      "        baseUrl: \"${2:https://jsonplaceholder.typicode.com}\"",
      "        timeout: ${3:5s}",
      "    }",
      "}"
    ]
  },
  "HTTP GET": {
    "prefix": "httpget",
    "description": "Send an HTTP GET request",
    "body": [
      "http.get(\"${1:https://jsonplaceholder.typicode.com/posts/1}\")"
    ]
  },
  "HTTP JSON POST": {
    "prefix": "httppost",
    "description": "Send an HTTP POST request with a JSON body",
    "body": [
      "http.post(\"${1:https://jsonplaceholder.typicode.com/posts}\") {",
      "    json: {",
      "        ${2:name}: ${3:\"value\"}",
      "    }",
      "}"
    ]
  }
}
