{
  "name": "mettle-language",
  "displayName": "Mettle Language",
  "description": "Language support for the Mettle I/O-oriented programming language.",
  "version": "0.9.0",
  "publisher": "mettle-lang",
  "license": "UNLICENSED",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:mettle",
    "onCommand:mettle.runFlow"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "mettle",
    "http",
    "load testing",
    "language"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "mkdir -p dist && npx --yes @vscode/vsce@4.0.0 package --allow-missing-repository --out dist/mettle-language-0.9.0.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "mettle.runFlow",
        "title": "Mettle: Run Flow",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "Mettle",
      "properties": {
        "mettle.executablePath": {
          "type": "string",
          "default": "mettle",
          "description": "Path or command name for the Mettle CLI used by Run Flow CodeLens actions."
        }
      }
    },
    "languages": [
      {
        "id": "mettle",
        "aliases": [
          "Mettle",
          "mettle"
        ],
        "extensions": [
          ".mettle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mettle",
        "scopeName": "source.mettle",
        "path": "./syntaxes/mettle.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mettle",
        "path": "./snippets/mettle.json"
      }
    ]
  }
}
