context localLoad {
    defaults http {
        baseUrl: env("METTLE_BASE_URL")
        timeout: 5s
        headers: {
            "Authorization": "Bearer local-test-token"
        }
    }
}

flow main() {
    use context localLoad

    load = rate(target: 1_000, period: 1s, duration: 5s, limit: 256) {
        http.get("/seed")
    }

    assert(load.failed == 0)
    return load
}
