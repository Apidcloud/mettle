context localApi {
    defaults http {
        baseUrl: env("METTLE_BASE_URL")
        timeout: 2s
        headers: {
            "Authorization": "Bearer local-test-token"
        }
    }
}

flow main {
    use context localApi

    posted = http.post("/method", body: { action: "create" })
    put = http.put("/method", body: "replacement")
    patched = http.patch("/method", headers: { "Content-Type": "application/merge-patch+json" }, body: { active: true })
    jsonString = http.post("/method", body: "Ada", bodyFormat: "json")
    namedUrl = http.post(body: [1, 2], url: "/method")
    rawCopy = http.post("/method", body: posted.bodyBytes)
    deleted = http.delete("/method")
    head = http.head("/method")
    options = http.options("/method")

    assert(posted.status == 200)
    assert(posted.duration < 2s)
    assert(put.status == 200)
    assert(patched.status == 200)
    assert(deleted.status == 200)
    assert(head.status == 200)
    assert(options.status == 204)

    return {
        posted: posted.json
        postedResponseBody: posted.body
        put: put.json
        patched: patched.json
        jsonString: jsonString.json
        namedUrl: namedUrl.json
        rawCopy: rawCopy.json
        deleted: deleted.json
        headBody: head.body
        allowed: options.headers["allow"]
        responseContentType: posted.headers["content-type"]
    }
}
