namespace core

context base {
    baseUrl: env("FLOW_BASE_URL")
    apiToken: env("FLOW_API_TOKEN")

    defaults http {
        baseUrl: baseUrl
        headers: {
            "Authorization": "Bearer ${apiToken}"
        }
    }
}

context api {
    use context base

    defaults http {
        timeout: 2s
        headers: {
            "Accept": "application/json"
        }
    }
}
